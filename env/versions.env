# Pinned environment for the TornadoVM hands-on lab.
# Every script in this repository sources this file; change versions here only.

# TornadoVM SDKs (SDKMAN! identifiers)
TORNADOVM_VERSION=7.1.0
TORNADOVM_SDK_MAC=7.1.0-jdk22plus-metal
TORNADOVM_SDK_LINUX=7.1.0-jdk22plus-cuda
TORNADOVM_SDK_LINUX_OPENCL=7.1.0-jdk22plus-opencl   # Intel, AMD or NVIDIA through OpenCL
JAVA_SDK=25.0.2-open

# External repositories used by the README-only demos
CUDA_DEMOS_REPO=https://github.com/beehive-lab/tornadovm-devoxx2026-cuda-demos
CUDA_DEMOS_REF=main                      # TODO: pin the commit rehearsed on
CUDA_DEMOS_TORNADOVM_SDK=7.0.0-jdk22plus-cuda   # the SDK that repo pins (L04 fancyTile.sh, L05)
JITLLM_REPO=https://github.com/beehive-lab/jitllm
JITLLM_REF=feature/stream-usage
DEVOXXGENIE_REPO=https://github.com/stratika/DevoxxGenieIDEAPlugin
DEVOXXGENIE_REF=feature/jitllm-openai-server
TORNADOINSIGHT_REPO=https://github.com/beehive-lab/tornado-insight
TORNADOVMPULSE_REPO=https://github.com/beehive-lab/TornadoVMPulse
TORNADOVIZ_REPO=https://github.com/beehive-lab/TornadoViz
TORNADOVM_REPO=https://github.com/beehive-lab/TornadoVM
KOTLIN_PR=1123

# Model used by L06-L10
JITLLM_MODEL=gemma-4-E2B-it-Q4_0.gguf
JITLLM_MODEL_URL=https://huggingface.co/unsloth/gemma-4-E2B-it-GGUF/resolve/main/gemma-4-E2B-it-Q4_0.gguf

# GPU memory budgets. Override per run, e.g.  TORNADO_DEVICE_MEMORY=8GB demos/L02-metal-look-inside/run.sh
# TornadoVM: -Dtornado.device.memory, default 4GB when left empty.
TORNADO_DEVICE_MEMORY="${TORNADO_DEVICE_MEMORY:-}"
# jitLLM: --gpu-memory, default 14GB; 15GB for 3-7B models, 20GB for 8B+.
JITLLM_GPU_MEMORY="${JITLLM_GPU_MEMORY:-14GB}"

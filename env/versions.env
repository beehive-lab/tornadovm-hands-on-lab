# Pinned environment for the TornadoVM hands-on lab.
# Every script in this repository sources this file; change versions here only.

# TornadoVM SDKs (SDKMAN! identifiers)
TORNADOVM_VERSION=7.1.0
TORNADOVM_SDK_MAC=7.1.0-jdk22plus-metal
TORNADOVM_SDK_LINUX=7.1.0-jdk22plus-cuda
TORNADOVM_SDK_LINUX_OPENCL=7.1.0-jdk22plus-opencl   # Intel, AMD or NVIDIA through OpenCL
JAVA_SDK=25.0.2-open
JITLLM_JAVA_SDK=21.0.2-open   # only for a jitLLM jar built for JDK 21 (feature/stream-usage, L10)

# External repositories used by the README-only demos
CUDA_DEMOS_REPO=https://github.com/beehive-lab/tornadovm-devoxx2026-cuda-demos
CUDA_DEMOS_REF=main                      # TODO: pin the commit rehearsed on
CUDA_DEMOS_TORNADOVM_SDK=7.0.0-jdk22plus-cuda   # the SDK that repo pins (L04 fancyTile.sh, L05)
MLX_TORNADOVM_SDK=7.3.1-jdk22plus-metal        # L14: tornado-mlx (Apple MLX library tasks) ships from 7.3.0; L14 runs L15, built against 7.3.1
# L15: a Maven project; tornado-mlx is on Maven Central from 7.3.1, so L15 runs on 7.3.1 SDKs
STARTER_TORNADOVM_MAVEN=7.3.1-jdk22plus        # io.github.beehive-lab:tornado-* version Maven compiles against
STARTER_TORNADOVM_SDK_MAC=7.3.1-jdk22plus-metal
STARTER_TORNADOVM_SDK_LINUX=7.3.1-jdk22plus-cuda
STARTER_TORNADOVM_SDK_LINUX_OPENCL=7.3.1-jdk22plus-opencl
# L16: Quarkus + LangChain4j on jitLLM 1.0.2, which needs TornadoVM 7.2+ (on 7.1.0: HalfFloatArray.getHalf4 does not resolve)
QUARKUS_TORNADOVM_SDK_MAC=7.3.1-jdk22plus-metal
QUARKUS_TORNADOVM_SDK_LINUX=7.3.1-jdk22plus-cuda
QUARKUS_TORNADOVM_SDK_LINUX_OPENCL=7.3.1-jdk22plus-opencl
JITLLM_REPO=https://github.com/beehive-lab/jitllm
JITLLM_REF=main                          # L06-L10; builds against the SDK in TORNADOVM_HOME
JITLLM_STREAM_USAGE_REF=feature/stream-usage   # L10, optional: token counts in DevoxxGenie
DEVOXXGENIE_REPO=https://github.com/stratika/DevoxxGenieIDEAPlugin
DEVOXXGENIE_REF=feature/jitllm-openai-server
TORNADOINSIGHT_REPO=https://github.com/beehive-lab/tornado-insight
TORNADOVMPULSE_REPO=https://github.com/beehive-lab/TornadoVMPulse
TORNADOVIZ_REPO=https://github.com/beehive-lab/TornadoViz
TORNADOVM_REPO=https://github.com/beehive-lab/TornadoVM
KOTLIN_PR=1123
FLINK_ACCEL_REPO=https://github.com/mairooni/flink-accelerator-tornadovm   # L11, L12; its demos/1-fetch.sh builds the rest
FLINK_ACCEL_REF=master
JITLLM_QUARKUS_REPO=https://github.com/beehive-lab/JitLLM-Quarkus-Langchain4j-Demo   # L16
JITLLM_QUARKUS_REF=main
QUARKUS_LC4J_REPO=https://github.com/quarkiverse/quarkus-langchain4j   # L16: the jitllm provider, unreleased
QUARKUS_LC4J_PR=2888                     # built from this pull request and installed as 999-SNAPSHOT

# Model used by L06-L10
JITLLM_MODEL="${JITLLM_MODEL:-gemma-4-E2B-it-Q8_0.gguf}"   # override per run, with JITLLM_MODEL_DIR for its folder
JITLLM_MODEL_URL=https://huggingface.co/unsloth/gemma-4-E2B-it-GGUF/resolve/main/gemma-4-E2B-it-Q8_0.gguf

# GPU memory budgets. Override per run, e.g.  TORNADO_DEVICE_MEMORY=8GB demos/L02-metal-look-inside/run.sh
# TornadoVM: -Dtornado.device.memory, default 4GB when left empty.
TORNADO_DEVICE_MEMORY="${TORNADO_DEVICE_MEMORY:-}"
# jitLLM: --gpu-memory, default 14GB; 15GB for 3-7B models, 20GB for 8B+.
JITLLM_GPU_MEMORY="${JITLLM_GPU_MEMORY:-14GB}"

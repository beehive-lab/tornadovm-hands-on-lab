<?xml version="1.0" encoding="UTF-8"?>
<!-- L18 · Matrix multiplication on the GPU, the finished application of L17, started ahead of time.
       ./mvnw package     target/matmul.jar, which aot.sh starts three ways (an AOT cache accepts jars only)
     tornado-api is provided: Maven compiles against it, the SDK brings its own jars at run time.
     Keep tornadovm.version in step with AOT_TORNADOVM_MAVEN in env/versions.env. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>l18-matmul-aot</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.release>22</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 8.0.0: the first SDK with the Leyden AOT cache (the aotCache option of tornado) and tornado-native-image -->
        <tornadovm.version>8.1.0-jdk22plus</tornadovm.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.beehive-lab</groupId>
            <artifactId>tornado-api</artifactId>
            <version>${tornadovm.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>matmul</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <!-- TornadoVM's annotation processor is not needed to compile; keep the build quiet -->
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
